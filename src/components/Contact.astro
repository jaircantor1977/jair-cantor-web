---
const { t } = Astro.props;
const { contact } = t;
---
<section class="final-cta" id="contacto">
  <div class="final-cta-copy">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2>{contact.title}</h2>
    <p>{contact.description}</p>
  </div>
  <div class="contact-links" aria-label={contact.linksLabel}>
    <a class="contact-link contact-email" href={`mailto:${contact.email}`}>
      <span class="contact-icon" aria-hidden="true">M</span>
      <span>
        <strong>{contact.emailLabel}</strong>
        <small>{contact.email}</small>
      </span>
    </a>
    <a class="contact-link contact-linkedin" href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer">
      <span class="contact-icon" aria-hidden="true">in</span>
      <span>
        <strong>{contact.linkedinLabel}</strong>
        <small>{contact.linkedinDescription}</small>
      </span>
    </a>
  </div>
</section>
