---
const { t } = Astro.props;
const { contact } = t;
const whatsappUrl = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
<section class="final-cta" id="contacto">
  <div class="final-cta-copy">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2>{contact.title}</h2>
    <p>{contact.description}</p>
  </div>
  <div class="contact-links" aria-label={contact.linksLabel}>
    <a class="contact-link contact-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-track="contact_whatsapp">
      <span class="contact-icon" aria-hidden="true">W</span>
      <span>
        <strong>{contact.whatsappLabel}</strong>
        <small>{contact.whatsappDescription}</small>
      </span>
    </a>
    <a class="contact-link contact-agenda" href={t.booking.call} target="_blank" rel="noopener" data-track="book_contact">
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
      </span>
      <span>
        <strong>{contact.agendaLabel}</strong>
        <small>{contact.agendaDescription}</small>
      </span>
    </a>
    <a class="contact-link contact-email" href={`mailto:${contact.email}`} data-track="contact_email">
      <span class="contact-icon" aria-hidden="true">M</span>
      <span>
        <strong>{contact.emailLabel}</strong>
        <small>{contact.email}</small>
      </span>
    </a>
    <a class="contact-link contact-linkedin" href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" data-track="contact_linkedin">
      <span class="contact-icon" aria-hidden="true">in</span>
      <span>
        <strong>{contact.linkedinLabel}</strong>
        <small>{contact.linkedinDescription}</small>
      </span>
    </a>
  </div>
</section>

