---
const { plan, booking = {} } = Astro.props;
const bookingUrl = plan.booking && booking[plan.booking];
// Text prices ("Por definir", "Cotización", "Sin costo") get a smaller type size than "$450 USD".
const isAmount = /^\$\s?\d/.test(plan.price);
---
<article class:list={["price-card", plan.style]}>
  {plan.badge && <div class="badge">{plan.badge}</div>}
  <p>{plan.name}</p>
  <h3 class:list={{ "price-text": !isAmount }}>{plan.price}</h3>
  {plan.priceNote && <small class="price-note">{plan.priceNote}</small>}
  <span>{plan.delivery}</span>
  <ul>
    {plan.features.map((feature) => <li>{feature}</li>)}
  </ul>
  {plan.cta && (bookingUrl
    ? <a class="button primary price-cta" href={bookingUrl} target="_blank" rel="noopener" data-track={`book_${plan.booking}`}>{plan.cta}</a>
    : <a class="button primary price-cta" href="#contacto" data-track={`pricing_${plan.name}`}>{plan.cta}</a>)}
</article>
