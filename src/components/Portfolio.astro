---
const { t } = Astro.props;
const { portfolio } = t;
const { product } = portfolio;
---
<section class="section dark portfolio-section" id="portafolio">
  <div class="section-intro">
    <p class="eyebrow">{portfolio.eyebrow}</p>
    <h2>{portfolio.title}</h2>
    <p>{portfolio.description}</p>
  </div>

  <article class="product-feature">
    <div class="product-copy">
      <p class="case-kicker">{product.kicker}</p>
      <img class="product-logo" src={product.logo} width="250" height="64" alt={product.logoAlt}>
      <h3>{product.tagline}</h3>
      <p>{product.description}</p>
      <ul class="product-features">
        {product.features.map((feature) => <li>{feature}</li>)}
      </ul>
      <ul class="tag-list">
        {product.stack.map((item) => <li>{item}</li>)}
      </ul>
      <div class="product-actions">
        <a class="button primary" href={t.booking.wolf} target="_blank" rel="noopener" data-track="book_wolf">{product.cta}</a>
        <a class="button secondary" href="#precios-sql">{product.pricingLink}</a>
        <span>{product.status}</span>
      </div>
    </div>
    <div class="product-visual">
      <figure class="product-shots">
        <a class="product-shot-main" href={product.screenshots[0].src} target="_blank" rel="noopener">
          <img src={product.screenshots[0].src} width="1600" height="1000" loading="lazy" decoding="async" alt={product.screenshots[0].alt}>
        </a>
        <div class="product-shot-row">
          {product.screenshots.slice(1).map((shot) => (
            <a href={shot.src} target="_blank" rel="noopener">
              <img src={shot.src} width="1600" height="1000" loading="lazy" decoding="async" alt={shot.alt}>
            </a>
          ))}
        </div>
        <figcaption>{product.screenshotNote}</figcaption>
      </figure>
      <dl class="product-metrics">
        {product.metrics.map((metric) => (
          <div>
            <dt>{metric.value}</dt>
            <dd>{metric.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </article>

  <h3 class="projects-title">{portfolio.projectsTitle}</h3>
  <div class="projects-grid">
    {portfolio.projects.map((project) => (
      <article class:list={["project-card", { "has-image": project.image }]}>
        {project.image && <img src={project.image} width="1200" height="717" loading="lazy" decoding="async" alt={project.alt}>}
        <div class="project-body">
          <p class="case-kicker">{project.kicker}</p>
          <h4>{project.name}</h4>
          <strong class="project-title">{project.title}</strong>
          <p>{project.description}</p>
          <ul class="project-highlights">
            {project.highlights.map((item) => <li>{item}</li>)}
          </ul>
          <ul class="tag-list">
            {project.stack.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
