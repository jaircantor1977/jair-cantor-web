---
const { t } = Astro.props;
const { dashboards } = t;
const initialKey = "finance";
const initialPeriod = 4;
const initial = dashboards.data[initialKey];

// Same rule as scripts/dashboard-demo.js so the first paint matches the interactive state.
const bars = initial.bars.map((value, index) => {
  const isPastPeriod = index <= initialPeriod;
  const height = isPastPeriod ? value : Math.max(14, value * 0.35);
  return { label: initial.labels[index], px: Math.round(height * 2), shown: isPastPeriod ? value : Math.round(height) };
});
---
<section class="section interactive-section" id="dashboards">
  <div class="section-intro">
    <p class="eyebrow">{dashboards.eyebrow}</p>
    <h2>{dashboards.title}</h2>
    <p>{dashboards.description}</p>
  </div>
  <div class="interactive-dashboard">
    <div class="dashboard-controls" aria-label={dashboards.controlsLabel}>
      {dashboards.tabs.map((tab) => (
        <button class:list={["data-tab", { "is-active": tab.key === initialKey }]} type="button" data-dashboard={tab.key}>{tab.label}</button>
      ))}
    </div>
    <div class="live-board">
      <div class="live-board-header">
        <div>
          <p class="case-kicker" data-live-kicker>{initial.kicker}</p>
          <h3 data-live-title>{initial.title}</h3>
        </div>
        <label>
          {dashboards.periodLabel}
          <input type="range" min="0" max={initial.bars.length - 1} value={initialPeriod} data-period-range>
        </label>
      </div>
      <div class="live-kpis">
        {initial.kpis.map(([label, value], index) => (
          <article>
            <span data-kpi-label={index}>{label}</span>
            <strong data-kpi-value={index}>{value}</strong>
          </article>
        ))}
      </div>
      <div class="live-chart-wrap">
        <div class="live-bars" data-live-bars aria-label={dashboards.chartLabel}>
          {bars.map((bar) => (
            <div class="live-bar"><i style={`--bar-height: ${bar.px}px`}></i><b>{bar.label}</b><span>{bar.shown}%</span></div>
          ))}
        </div>
        <div class="live-side">
          <div class="donut" data-donut style={`--value: ${initial.donut}%`}>
            <span data-donut-value>{initial.donut}%</span>
          </div>
          <p data-donut-label>{initial.donutLabel}</p>
        </div>
      </div>
      <div class="insight-strip" data-live-insight>{initial.insight}</div>
    </div>
  </div>
  <script is:inline type="application/json" data-dashboard-data set:html={JSON.stringify(dashboards.data)}></script>
</section>
